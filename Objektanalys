<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<meta name="apple-mobile-web-app-title" content="Objektanalys"/>
<meta name="theme-color" content="#1B2A52"/>
<link rel="apple-touch-icon" href="data:image/png;base64,"/>
<link rel="icon" type="image/png" href="data:image/png;base64,"/>
<title>Objektanalys</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#F5F3EE;color:#1a1a2e;min-height:100vh;-webkit-tap-highlight-color:transparent;}
input,button,textarea{font-family:inherit;}
@media print{
  .no-print{display:none!important;}
  body{background:white;}
  .tab-content{display:block!important;}
}
</style>
</head>
<body>
<div id="root"></div>
<script>
const NAVY="#1B2A52",GOLD="#B8960C",GOLD2="#C9A84C",WHITE="#FFFFFF",BORDER="#D5C9A0",LIGHT="#F5F3EE",BGRAY="#F0EDE5";
const LOGO="";

const num=v=>(!v||v===""?0:Number(v)||0);
const fmt=n=>n>0?"€\u00a0"+Math.round(n).toLocaleString("sv-SE"):"—";
const fmtF=n=>n!==0?(n<0?"- ":"")+"€\u00a0"+Math.round(Math.abs(n)).toLocaleString("sv-SE"):"—";
const pct=n=>n!==0?n.toFixed(1)+" %":"—";

const BADRUM_ITEMS=["Rivning & bortforsling","Plattsättning vägg","Plattsättning golv","Dusch / duschkabin","Badkar","WC-stol","Tvättställ & badrumsskåp","Armaturer & blandare","Golvvärme","Spegel & tillbehör","Ventilation"];
const WC_ITEMS=["Rivning & bortforsling","WC-stol","Tvättställ & blandare","Plattsättning vägg","Plattsättning golv","Spegel & belysning","Övrigt WC"];
const FIXED_SECS=[
  {key:"kok",lbl:"🍳 Kök",items:["Rivning & bortforsling","Köksstommar","Luckor & fronter","Bänkskiva","Diskbänk & blandare","Vitvaror (ugn, kyl, frys, diskmaskin)","Köksfläkt & ventilation","Kakel stänkskydd","Belysning kök","Övrigt kök"]},
  {key:"golv",lbl:"🪵 Golv & plattsättning",items:["Rivning & bortforsling","Avjämning / undergolv","Klinker / keramik (inomhus)","Klinker terrass / balkong","Parkett / laminat","Sockel & lister","Trappa & vilplan"]},
  {key:"maleri",lbl:"🖌️ Måleri & puts",items:["Rivning & bortforsling","Spackling & slipning","Målning väggar (inomhus)","Målning tak","Målning snickerier & dörrar","Fasadmålning (utomhus)","Stuckatur & puts","Garage / källare"]},
  {key:"snickeri",lbl:"🪚 Snickeri & inredning",items:["Rivning & bortforsling","Garderober & förvaring","Hyllor & skåp (custom)","Skärmväggar / mellanväggar","Taklist & snickeridetaljer","Trappräcken & ledstänger","Övrigt snickeri"]},
  {key:"el",lbl:"⚡ El & belysning",items:["Rivning & bortforsling","Elcentral & säkringar","Ledningsdragning","Uttag & strömbrytare","Belysningsarmaturer (inomhus)","Utomhusbelysning & spotlights","Laddbox EV / motorvärmare","Larm & skalskydd","Fiber / nätverk"]},
  {key:"vvs",lbl:"🔧 VVS (gemensamt)",items:["Rivning & bortforsling","Stambytte / dragning av rör","Varmvattenberedare / värmepump","Tvättstuga (maskin, tork, avlopp)","Dagvattenavledning / dränering","Bevattningssystem utomhus","Övrigt VVS"]},
  {key:"ac",lbl:"❄️ AC & värme",items:["Rivning & bortforsling","AC-enheter inomhus (split)","AC-kompressor (utomhus)","Installation & montering AC","Golvvärme elektrisk","Pelletskamin / braskamin","Värmepump luft-luft"]},
  {key:"pool",lbl:"🏊 Pool & spa",items:["Rivning & bortforsling","Pool renovering / nybygge","Pump, filter & saltanläggning","Pooltäckning / poolskydd","Spa / jacuzzi","Belysning pool","Poolhus / teknikrum"]},
  {key:"uteplats",lbl:"🌿 Uteplats & trädgård",items:["Rivning & bortforsling","Terrass / uteplats (konstruktion)","Markplattor / trädgårdsgolv","Pergola / markis / solskydd","Staket, häck & murar","Grönska, träd & planteringar","Belysning trädgård","Utomhuskök / BBQ-plats","Bevattning automatisk"]},
  {key:"dorrar",lbl:"🚪 Dörrar, fönster & fasad",items:["Rivning & bortforsling","Ytterdörr","Innerdörrar (alla)","Fönster (byte / renovering)","Persienner / rullgardiner","Garageport","Balkong- / terrassdörrar","Fasadrenovering / isolering"]},
  {key:"ovrigt",lbl:"📦 Rivning, städ & projekt",items:["Grovstädning & rivning","Container & sophantering","Ställningar (hyra)","Asbestsanering","Fuktskaderemediation","Diverse småreparationer","Projektledning / byggledning"]},
  {key:"mobler",lbl:"🛋️ Möbler & styling",items:["Vardagsrumsmöbler","Sovrumsmöbler","Matgrupp & köksstolar","Utomhusmöbler","Textilier (gardiner, sängkläder, handdukar)","Design-belysning","Konst, speglar & dekoration","Badrumsaccessoarer","Övrigt möbler & styling"]},
];
const RISKS=["Fukt","El","VVS","Juridik","Turistlicens","Ockupanter","Samfällighet","Struktur","Asbest","Ventilation"];
const TABS=[{id:"objekt",lbl:"🏠 Objekt"},{id:"kop",lbl:"📋 Köp"},{id:"renovering",lbl:"🔨 Renovering"},{id:"uthyrning",lbl:"📅 Uthyrning"},{id:"roi",lbl:"📊 ROI"}];
const NIVAER=["Minimal","Basnivå","Standard","Premium","Toppsäljning"];

let state={
  tab:"objekt",
  obj:{namn:"",adress:"",omrade:"",stad:"",typ:"",boyta:"",tomt:"",sovrum:"2",badrum:"2",wc:"1",alder:"",mäklare:"",kontakt:"",telefon:"",utgangspris:"",malPris:"",turistlicens:"",community:"",ibi:"",visning:""},
  kop:{kopeskilling:"",itp:"",jurist:"",notarie:"",lagfart:"",stämpel:"",bank:"",maklararvode:"",valuta:"",ovrigtKop:"",itpK:"",juristK:"",notarieK:"",lagfartK:"",stämpelK:"",bankK:"",maklarK:"",valutaK:"",ovrigtKK:""},
  renov:{},renovNiva:"Standard",buffertPct:"12",
  uth:{hogVecka:"",hogBelagg:"",mellVecka:"",mellBelagg:"",lagVecka:"",lagBelagg:"",stadning:"",forvPct:"",forvFast:"",el:"",forsakring:"",community:"",underhall:"",ovrigtDrift:"",stadK:"",elK:"",forsK:"",commK:"",undK:"",ovdriftK:"",marknadskomm:""},
  roi:{marknadsvarde:"",forsaljningspris:"",riskar:{},beslut:"",kommentarer:""},
  openSecs:{},
};

function getBad(){return Math.max(1,Math.min(8,num(state.obj.badrum)||1));}
function getWc(){return Math.max(0,Math.min(6,num(state.obj.wc)||0));}

function ensureRenov(){
  const nB=getBad(),nW=getWc();
  for(let i=1;i<=nB;i++){const k=`bad${i}`;if(!state.renov[k])state.renov[k]=BADRUM_ITEMS.map(it=>({label:`Badrum ${i} – ${it}`,arb:"",mat:"",komm:""}));}
  for(let i=nB+1;i<=8;i++)delete state.renov[`bad${i}`];
  for(let i=1;i<=nW;i++){const k=`wc${i}`;if(!state.renov[k])state.renov[k]=WC_ITEMS.map(it=>({label:`WC ${i} – ${it}`,arb:"",mat:"",komm:""}));}
  for(let i=nW+1;i<=6;i++)delete state.renov[`wc${i}`];
  FIXED_SECS.forEach(d=>{
    if(!state.renov[d.key]){state.renov[d.key]=d.items.map(it=>({label:it,arb:"",mat:"",komm:""}));}
    else{d.items.forEach(it=>{if(!state.renov[d.key].find(r=>r.label===it))state.renov[d.key].unshift({label:it,arb:"",mat:"",komm:""}); });}
  });
}
ensureRenov();

function set(path,val){const p=path.split(".");let o=state;for(let i=0;i<p.length-1;i++)o=o[p[i]];o[p[p.length-1]]=val;ensureRenov();render();}
function setRenov(sec,idx,field,val){state.renov[sec][idx][field]=val;render();}
function toggleSec(k){state.openSecs[k]=!state.openSecs[k];render();}
function toggleRisk(r){state.roi.riskar[r]=!state.roi.riskar[r];render();}
function setBeslut(k){state.roi.beslut=state.roi.beslut===k?"":k;render();}

function calcs(){
  const nB=getBad(),nW=getWc();
  const badKeys=Array.from({length:nB},(_,i)=>`bad${i+1}`);
  const wcKeys=Array.from({length:nW},(_,i)=>`wc${i+1}`);
  const kopKeys=["kopeskilling","itp","jurist","notarie","lagfart","stämpel","bank","maklararvode","valuta","ovrigtKop"];
  const kopTotal=kopKeys.reduce((s,k)=>s+num(state.kop[k]),0);
  const secTot=rows=>rows?rows.reduce((s,r)=>s+num(r.arb)+num(r.mat),0):0;
  const allRK=[...badKeys,...wcKeys,...FIXED_SECS.map(d=>d.key)];
  const renovBase=allRK.reduce((s,k)=>s+secTot(state.renov[k]),0);
  const buffert=renovBase*(num(state.buffertPct)/100);
  const renovTotal=renovBase+buffert;
  const totalInv=kopTotal+renovTotal;
  const hogI=num(state.uth.hogVecka)*(num(state.uth.hogBelagg)/100)*13;
  const mellI=num(state.uth.mellVecka)*(num(state.uth.mellBelagg)/100)*16;
  const lagI=num(state.uth.lagVecka)*(num(state.uth.lagBelagg)/100)*23;
  const arsInt=hogI+mellI+lagI;
  const forvKost=num(state.uth.forvPct)>0?arsInt*(num(state.uth.forvPct)/100):num(state.uth.forvFast);
  const driftTotal=["stadning","el","forsakring","community","underhall","ovrigtDrift"].reduce((s,k)=>s+num(state.uth[k]),0)+forvKost;
  const netto=arsInt-driftTotal;
  const forsP=num(state.roi.forsaljningspris);
  const vinst=forsP-totalInv;
  const roiPct=totalInv>0?(vinst/totalInv)*100:0;
  const yieldPct=totalInv>0?(netto/totalInv)*100:0;
  const boyta=num(state.obj.boyta);
  return {kopTotal,renovBase,buffert,renovTotal,totalInv,arsInt,forvKost,driftTotal,netto,forsP,vinst,roiPct,yieldPct,boyta,badKeys,wcKeys,allRK,hogI,mellI,lagI,secTot};
}

// ── HTML builders ──────────────────────────────────────────────────────────────
function iStyle(align,extra=""){return `background:#fff;border:1px solid ${BORDER};color:#1a1a2e;font-family:inherit;font-size:14px;padding:8px 10px;border-radius:5px;width:100%;outline:none;text-align:${align};${extra}`;}
function inp(path,type="text",ph="",align="left",extra=""){
  const p=path.split(".");let o=state;for(const k of p)o=o[k];
  return `<input type="${type}" value="${String(o||"").replace(/"/g,"&quot;")}" placeholder="${ph}" onchange="set('${path}',this.value)" style="${iStyle(align,extra)}" ${type==="number"?"inputmode='decimal'":""}/>`;
}
function ta(path,rows=4,ph=""){
  const p=path.split(".");let o=state;for(const k of p)o=o[k];
  return `<textarea rows="${rows}" placeholder="${ph}" onchange="set('${path}',this.value)" style="${iStyle("left","resize:vertical;")}">${String(o||"").replace(/</g,"&lt;")}</textarea>`;
}
function field(label,content){return `<div style="display:flex;flex-direction:column;gap:4px;"><label style="font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#5a6070;">${label}</label>${content}</div>`;}
function secHdr(icon,title){return `<div style="display:flex;align-items:center;gap:10px;border-left:4px solid ${GOLD};padding-left:12px;margin:36px 0 16px;"><span style="font-size:18px;">${icon}</span><h2 style="font-family:Georgia,serif;font-size:17px;color:${NAVY};font-weight:600;margin:0;">${title}</h2></div>`;}

// Summary row inside a panel
function trow(label,val,hi=false,col=""){
  const bg=hi?NAVY:"transparent",lc=hi?GOLD2:"#5a6070",vc=col||(hi?GOLD2:NAVY),lfs=hi?15:14,vfs=hi?17:14,fw=hi?700:400;
  return `<tr style="background:${bg};border-bottom:1px solid #eee;">
    <td style="padding:9px 18px;font-size:${lfs}px;color:${lc};font-weight:${fw};">${label}</td>
    <td style="padding:9px 18px;font-size:${vfs}px;font-weight:600;color:${vc};text-align:right;">${val}</td></tr>`;
}
function tpanel(title,rows,mt=14){
  return `<div style="background:#fff;border:1px solid ${BORDER};border-radius:8px;overflow:hidden;margin-top:${mt}px;">
    <div style="background:${NAVY};padding:10px 18px;color:${GOLD2};font-family:Georgia,serif;font-size:14px;">${title}</div>
    <table style="width:100%;border-collapse:collapse;"><tbody>${rows}</tbody></table></div>`;
}

// Renovation section with inline totals per row + delsumma
function renovSec(key,title){
  const rows=state.renov[key]||[];
  const tot=rows.reduce((s,r)=>s+num(r.arb)+num(r.mat),0);
  const open=!!state.openSecs[key];
  let h=`<div style="margin-bottom:10px;border:1px solid ${BORDER};border-radius:7px;overflow:hidden;">
    <div onclick="toggleSec('${key}')" style="background:${NAVY};padding:10px 14px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;">
      <span style="font-size:13px;font-weight:600;color:${GOLD2};">${title}</span>
      <span style="display:flex;gap:10px;align-items:center;">
        ${tot>0?`<span style="font-size:13px;color:${GOLD2};font-weight:700;">€ ${tot.toLocaleString("sv-SE")}</span>`:""}
        <span style="font-size:11px;color:#8899bb;transition:transform 0.2s;display:inline-block;transform:${open?"rotate(180deg)":"none"};">▼</span>
      </span></div>`;
  if(open){
    h+=`<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;">
      <thead><tr style="background:${BGRAY};">
        <th style="padding:6px 10px;font-size:10px;text-transform:uppercase;color:${NAVY};font-weight:700;border-bottom:1px solid ${BORDER};text-align:left;width:32%;">Åtgärd</th>
        <th style="padding:6px 10px;font-size:10px;text-transform:uppercase;color:${NAVY};font-weight:700;border-bottom:1px solid ${BORDER};text-align:right;width:16%;">Arbete EUR</th>
        <th style="padding:6px 10px;font-size:10px;text-transform:uppercase;color:${NAVY};font-weight:700;border-bottom:1px solid ${BORDER};text-align:right;width:16%;">Material EUR</th>
        <th style="padding:6px 10px;font-size:10px;text-transform:uppercase;color:${NAVY};font-weight:700;border-bottom:1px solid ${BORDER};text-align:right;width:14%;">Totalt</th>
        <th style="padding:6px 10px;font-size:10px;text-transform:uppercase;color:${NAVY};font-weight:700;border-bottom:1px solid ${BORDER};text-align:left;">Kommentar</th>
      </tr></thead><tbody>`;
    rows.forEach((row,i)=>{
      const rt=(Number(row.arb)||0)+(Number(row.mat)||0);
      const arb=String(row.arb||"").replace(/"/g,"&quot;");
      const mat=String(row.mat||"").replace(/"/g,"&quot;");
      const komm=String(row.komm||"").replace(/"/g,"&quot;");
      h+=`<tr style="border-bottom:1px solid #f0ede5;${i%2===1?"background:#fafaf7;":""}">
        <td style="padding:5px 10px;font-size:12px;color:#333;">${row.label.replace(/</g,"&lt;")}</td>
        <td style="padding:3px 4px;"><input type="number" value="${arb}" placeholder="0" onchange="setRenov('${key}',${i},'arb',this.value)" style="width:100%;background:#fff;border:1px solid ${BORDER};padding:5px 7px;border-radius:4px;text-align:right;font-size:12px;outline:none;font-family:inherit;"/></td>
        <td style="padding:3px 4px;"><input type="number" value="${mat}" placeholder="0" onchange="setRenov('${key}',${i},'mat',this.value)" style="width:100%;background:#fff;border:1px solid ${BORDER};padding:5px 7px;border-radius:4px;text-align:right;font-size:12px;outline:none;font-family:inherit;"/></td>
        <td style="font-weight:700;color:${rt>0?NAVY:"#ccc"};text-align:right;padding-right:10px;font-size:13px;white-space:nowrap;">${rt>0?"€ "+rt.toLocaleString("sv-SE"):"—"}</td>
        <td style="padding:3px 4px;"><input type="text" value="${komm}" placeholder="anteckning..." onchange="setRenov('${key}',${i},'komm',this.value)" style="width:100%;background:#fff;border:1px solid ${BORDER};padding:5px 7px;border-radius:4px;font-size:11px;color:#666;outline:none;font-family:inherit;"/></td></tr>`;
    });
    h+=`</tbody></table></div>`;
    // Delsumma bar under tabellen
    h+=`<div style="display:flex;justify-content:flex-end;align-items:center;gap:16px;padding:10px 16px;background:${NAVY};">
      <span style="font-size:11px;text-transform:uppercase;letter-spacing:0.08em;color:#8899bb;">Delsumma ${title.replace(/[^\w\s&åäöÅÄÖ]/g,"").trim()}</span>
      <strong style="font-size:16px;color:${GOLD2};">€ ${tot.toLocaleString("sv-SE")}</strong></div>`;
  }
  return h+`</div>`;
}

function render(){
  const c=calcs();
  const nB=getBad(),nW=getWc();
  let h="";

  // HEADER
  h+=`<div style="background:${NAVY};border-bottom:3px solid ${GOLD};display:flex;align-items:center;gap:16px;padding:12px 20px;">
    
    <div style="flex:1;min-width:0;">
      <div style="font-family:Georgia,serif;color:${GOLD2};font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Objektanalys &amp; Projektkalkyl</div>
      <div style="color:#8899bb;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;margin-top:2px;">Fastighetsanalys — Spanien</div>
    </div></div>`;

  // PDF-knapp
  h+=`<div class="no-print" style="background:#F0EDE5;border-bottom:1px solid ${BORDER};padding:8px 20px;display:flex;justify-content:flex-end;">
    <button onclick="window.print()" style="background:${NAVY};color:${GOLD2};border:none;padding:9px 20px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;">🖨️ Spara som PDF</button></div>`;

  // TABS
  h+=`<div class="no-print" style="display:flex;background:${NAVY};border-bottom:2px solid ${GOLD}40;overflow-x:auto;">`;
  TABS.forEach(t=>{const ac=state.tab===t.id;h+=`<button onclick="set('tab','${t.id}')" style="padding:11px 14px;background:none;border:none;border-bottom:3px solid ${ac?GOLD2:"transparent"};color:${ac?GOLD2:"#8899bb"};font-family:inherit;font-size:12px;font-weight:500;cursor:pointer;white-space:nowrap;">${t.lbl}</button>`;});
  h+=`</div><div style="padding:18px 18px 60px;">`;

  // ══ OBJEKT ══
  if(state.tab==="objekt"){
    h+=secHdr("🏠","Grunddata");
    h+=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;">`;
    [["obj.namn","Objektnamn"],["obj.adress","Adress"],["obj.omrade","Område"],["obj.stad","Stad"],["obj.typ","Fastighetstyp"],["obj.alder","Byggnadsår"]].forEach(([p,l])=>{h+=field(l,inp(p));});
    h+=field("Boyta m²",inp("obj.boyta","number","0","right"));
    h+=field("Tomt m²",inp("obj.tomt","number","0","right"));
    h+=field("Antal sovrum",inp("obj.sovrum","number","0","right"));
    h+=field("Antal badrum",inp("obj.badrum","number","0","right"));
    h+=field("Antal WC / toaletter",inp("obj.wc","number","0","right"));
    h+=`</div>`;
    h+=secHdr("💰","Pris &amp; Kontakt");
    h+=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;">`;
    [["obj.mäklare","Mäklare"],["obj.kontakt","Kontakt"],["obj.telefon","Telefon / E-post"]].forEach(([p,l])=>{h+=field(l,inp(p));});
    h+=field("Utgångspris EUR",inp("obj.utgangspris","number","0","right"));
    h+=field("GP Målpris EUR",inp("obj.malPris","number","0","right"));
    h+=field("Turistlicens",inp("obj.turistlicens","text","Ja / Nej / Ansökt"));
    h+=field("Community fee / år EUR",inp("obj.community","number","0","right"));
    h+=field("IBI / år EUR",inp("obj.ibi","number","0","right"));
    h+=`</div>`;
    if(c.boyta>0){
      h+=`<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0;">`;
      [[fmt(num(state.obj.utgangspris)/c.boyta),"Begärt / m²","Utgångspris"],[fmt(c.totalInv>0?c.totalInv/c.boyta:0),"Total invest. / m²","Köp + renov"],[fmt(c.forsP>0?c.forsP/c.boyta:0),"Säljpris / m²","Förväntat exit"]].forEach(([v,l,s])=>{
        h+=`<div style="background:#fff;border:1px solid ${BORDER};border-top:3px solid ${GOLD};border-radius:6px;padding:10px 12px;"><div style="font-size:10px;text-transform:uppercase;letter-spacing:0.08em;color:#8090a0;">${l}</div><div style="font-family:Georgia,serif;font-size:17px;color:${NAVY};margin-top:3px;">${v}</div><div style="font-size:10px;color:#a0aab0;">${s}</div></div>`;
      });
      h+=`</div>`;
    }
    h+=secHdr("📝","Visningsanteckningar");
    h+=ta("obj.visning",5,"Skick, läge, potential, noterat vid visning...");
  }

  // ══ KÖP ══
  if(state.tab==="kop"){
    h+=secHdr("📋","Köpkostnader (Spanien)");
    h+=`<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;">
      <thead><tr style="background:${NAVY};">
        <th style="padding:8px 12px;color:${GOLD2};font-size:10px;text-transform:uppercase;text-align:left;border-bottom:2px solid ${GOLD};width:40%;">Post</th>
        <th style="padding:8px 12px;color:${GOLD2};font-size:10px;text-transform:uppercase;text-align:right;border-bottom:2px solid ${GOLD};">Budget EUR</th>
        <th style="padding:8px 12px;color:${GOLD2};font-size:10px;text-transform:uppercase;text-align:left;border-bottom:2px solid ${GOLD};">Kommentar</th>
      </tr></thead><tbody>`;
    const kopDefs=[["kopeskilling","Köpeskilling",""],["itp","ITP Transfer Tax (~8-10%)","itpK"],["jurist","Jurist / Advokat","juristK"],["notarie","Notarie (Escritura)","notarieK"],["lagfart","Registro de Propiedad","lagfartK"],["stämpel","Stämpelskatt AJD","stämpelK"],["bank","Bank / Bolånekostnader","bankK"],["maklararvode","Mäklararvode","maklarK"],["valuta","Valutaväxling","valutaK"],["ovrigtKop","Övrigt","ovrigtKK"]];
    kopDefs.forEach(([k,l,kk],i)=>{
      h+=`<tr style="border-bottom:1px solid #f0ede5;${i%2===1?"background:#fafaf7;":""}">
        <td style="padding:6px 12px;font-size:13px;">${l}</td>
        <td style="padding:3px 5px;">${inp("kop."+k,"number","0","right")}</td>
        <td style="padding:3px 5px;">${kk?inp("kop."+kk,"text","anteckning...","left","font-size:12px;color:#666;"):""}</td></tr>`;
    });
    h+=`</tbody></table></div>`;
    // Total under köp-tabellen
    let kr="";
    ["kopeskilling","itp","jurist","notarie","lagfart","stämpel","bank","maklararvode","valuta","ovrigtKop"].filter(k=>num(state.kop[k])>0).forEach(k=>{kr+=trow(k,fmt(num(state.kop[k])));});
    kr+=trow("TOTAL KÖPKOSTNAD",fmt(c.kopTotal),true);
    if(c.boyta>0)kr+=trow(`Köp per m² (${c.boyta} m²)`,fmt(c.kopTotal/c.boyta));
    h+=tpanel("📋 Summering köpkostnader",kr);
  }

  // ══ RENOVERING ══
  if(state.tab==="renovering"){
    // Niva selector
    h+=`<div class="no-print" style="display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:16px;margin-top:4px;">
      <span style="font-size:10px;color:#7a7060;text-transform:uppercase;letter-spacing:0.07em;">Nivå:</span>`;
    NIVAER.forEach(n=>{const ac=state.renovNiva===n;h+=`<button onclick="set('renovNiva','${n}')" style="padding:5px 12px;border-radius:20px;border:1px solid ${ac?NAVY:BORDER};background:${ac?NAVY:"#fff"};color:${ac?GOLD2:"#7a7060"};font-size:12px;cursor:pointer;">${n}</button>`;});
    h+=`</div>`;

    // All sections with delsumma each
    c.badKeys.forEach((bk,i)=>{h+=renovSec(bk,`🚿 Badrum ${i+1}`);});
    c.wcKeys.forEach((wk,i)=>{h+=renovSec(wk,`🪠 WC ${i+1}`);});
    FIXED_SECS.forEach(d=>{h+=renovSec(d.key,d.lbl);});

    // ── STOR SLUTSUMMA RENOVERING ──
    let rr="";
    c.allRK.forEach(k=>{
      const t=c.secTot(state.renov[k]);
      if(t>0){
        const lbl=k.startsWith("bad")?`🚿 Badrum ${k.slice(3)}`:k.startsWith("wc")?`🪠 WC ${k.slice(2)}`:FIXED_SECS.find(d=>d.key===k)?.lbl||k;
        rr+=trow(lbl,fmt(t));
      }
    });
    rr+=`<tr><td colspan="2" style="height:1px;background:${BORDER};padding:0;"></td></tr>`;
    rr+=trow("Delsumma alla kategorier",fmt(c.renovBase));
    rr+=`<tr style="border-bottom:1px solid #eee;">
      <td style="padding:10px 18px;font-size:14px;color:#5a6070;">
        Buffert&nbsp;&nbsp;<input type="number" value="${state.buffertPct}" onchange="set('buffertPct',this.value)" style="width:52px;background:#f7f4ed;border:1px solid ${BORDER};border-radius:4px;padding:4px 8px;text-align:center;outline:none;font-size:13px;"/>&nbsp;%
      </td>
      <td style="padding:10px 18px;text-align:right;font-weight:700;color:${NAVY};font-size:14px;">${fmt(c.buffert)}</td></tr>`;
    rr+=trow("TOTAL RENOVERING inkl. buffert",fmt(c.renovTotal),true);

    h+=tpanel("🔨 Slutsumma Renovering — "+state.renovNiva,rr,20);

    // Projektöversikt
    let pr=trow("Total köpkostnad",fmt(c.kopTotal));
    pr+=trow("Total renovering inkl. buffert",fmt(c.renovTotal));
    pr+=trow("TOTAL INVESTERING",fmt(c.totalInv),true);
    if(c.boyta>0)pr+=trow(`Total invest. per m² (${c.boyta} m²)`,fmt(c.totalInv/c.boyta));
    h+=tpanel("💰 Total projektöversikt",pr,10);
  }

  // ══ UTHYRNING ══
  if(state.tab==="uthyrning"){
    h+=secHdr("📅","Säsongskalkyl");
    h+=`<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;">
      <thead><tr style="background:${NAVY};">${["Säsong","Veckohyra EUR","Beläggning %","Veckor","Intäkt EUR"].map(hd=>`<th style="padding:8px 10px;color:${GOLD2};font-size:10px;text-transform:uppercase;text-align:left;border-bottom:2px solid ${GOLD};">${hd}</th>`).join("")}</tr></thead><tbody>`;
    [["Högsäsong (jun–aug)","uth.hogVecka","uth.hogBelagg",13,c.hogI],["Mellansäsong (apr–maj, sep–okt)","uth.mellVecka","uth.mellBelagg",16,c.mellI],["Lågsäsong (nov–mar)","uth.lagVecka","uth.lagBelagg",23,c.lagI]].forEach(([l,vk,bk,wk,ik])=>{
      h+=`<tr style="border-bottom:1px solid ${BORDER};">
        <td style="padding:7px 10px;font-size:13px;">${l}</td>
        <td style="padding:3px 4px;">${inp(vk,"number","0","right")}</td>
        <td style="padding:3px 4px;">${inp(bk,"number","0–100","right")}</td>
        <td style="text-align:center;color:#7a7060;font-size:12px;">${wk}</td>
        <td style="text-align:right;font-weight:700;color:${NAVY};padding-right:10px;font-size:14px;">${ik>0?fmt(ik):"—"}</td></tr>`;
    });
    h+=`<tr style="background:${NAVY};"><td colspan="4" style="padding:9px 10px;font-size:13px;color:#8899bb;font-weight:600;">Årsintäkt totalt</td>
      <td style="text-align:right;font-weight:700;color:${GOLD2};padding-right:10px;font-size:16px;">${fmt(c.arsInt)}</td></tr>`;
    h+=`</tbody></table></div>`;

    h+=secHdr("💸","Driftskostnader per år");
    h+=`<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;">
      <thead><tr style="background:${NAVY};">${["Kostnad","EUR / år","Kommentar"].map((hd,i)=>`<th style="padding:8px 10px;color:${GOLD2};font-size:10px;text-transform:uppercase;text-align:${i>0?"right":"left"};border-bottom:2px solid ${GOLD};${i===0?"width:40%;":""}">${hd}</th>`).join("")}</tr></thead><tbody>`;
    h+=`<tr style="border-bottom:1px solid #f0ede5;"><td style="padding:6px 10px;font-size:13px;">Städning &amp; byten</td>
      <td style="padding:3px 4px;">${inp("uth.stadning","number","0","right")}</td>
      <td style="padding:3px 4px;">${inp("uth.stadK","text","ca x kr/st × x ggr/år","left","font-size:12px;color:#666;")}</td></tr>`;
    h+=`<tr style="background:#fafaf7;border-bottom:1px solid #f0ede5;"><td style="padding:6px 10px;font-size:13px;">Fastighetsförvaltning</td>
      <td style="padding:3px 4px;"><div style="display:flex;gap:5px;align-items:center;">${inp("uth.forvPct","number","%","right","max-width:55px;")}
        <span style="font-size:10px;color:#7a7060;white-space:nowrap;">% el.</span>${inp("uth.forvFast","number","fast €","right","max-width:85px;")}
      </div></td><td style="padding:3px 4px;font-size:12px;color:#888;">${c.forvKost>0?"= "+fmt(c.forvKost)+"/år":""}</td></tr>`;
    [["el","El / Vatten / Internet","elK"],["forsakring","Försäkring","forsK"],["community","Community fees + IBI","commK"],["underhall","Underhåll & reparationer","undK"],["ovrigtDrift","Övrigt","ovdriftK"]].forEach(([k,l,kk],i)=>{
      h+=`<tr style="${i%2===0?"":"background:#fafaf7;"}border-bottom:1px solid #f0ede5;"><td style="padding:6px 10px;font-size:13px;">${l}</td>
        <td style="padding:3px 4px;">${inp("uth."+k,"number","0","right")}</td>
        <td style="padding:3px 4px;">${inp("uth."+kk,"text","anteckning...","left","font-size:12px;color:#666;")}</td></tr>`;
    });
    // Drift total rad
    h+=`<tr style="background:${NAVY};"><td style="padding:9px 10px;font-size:13px;color:#8899bb;font-weight:600;">Totala driftskostnader</td>
      <td style="text-align:right;font-weight:700;color:${GOLD2};padding-right:10px;font-size:16px;">${fmt(c.driftTotal)}</td><td></td></tr>`;
    h+=`</tbody></table></div>`;

    // Netto panel
    let nr=trow("Årsintäkt brutto",fmt(c.arsInt));
    nr+=trow("Driftskostnader totalt",fmt(c.driftTotal));
    nr+=trow("Nettoresultat / år",fmt(c.netto),true,c.netto>=0?"#2ecc71":"#e74c3c");
    if(c.totalInv>0)nr+=trow("Direktavkastning (Yield)",pct(c.yieldPct));
    h+=tpanel("📊 Nettoresultat uthyrning",nr);

    h+=secHdr("💬","Marknadskommentar");
    h+=ta("uth.marknadskomm",4,"Hyresmarknaden, Airbnb/Booking, lokala regler, säsonger...");
  }

  // ══ ROI ══
  if(state.tab==="roi"){
    // KPI-kort
    h+=`<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px;">`;
    [[fmt(c.totalInv),"Total investering","Köp + renovering"],[fmt(c.netto)+(c.totalInv>0?" ("+pct(c.yieldPct)+")":""),"Netto uth. / år","Direktavkastning"],[c.forsP>0?pct(c.roiPct):"—","ROI vid försäljning","Kapitalvinst %"]].forEach(([v,l,s])=>{
      h+=`<div style="background:#fff;border:1px solid ${BORDER};border-top:3px solid ${GOLD};border-radius:6px;padding:10px 12px;"><div style="font-size:10px;text-transform:uppercase;letter-spacing:0.08em;color:#8090a0;">${l}</div><div style="font-family:Georgia,serif;font-size:16px;color:${NAVY};margin-top:3px;">${v}</div><div style="font-size:10px;color:#a0aab0;">${s}</div></div>`;
    });
    h+=`</div>`;

    h+=secHdr("📊","Exit &amp; Värdering");
    h+=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">`;
    [["roi.marknadsvarde","Förväntat marknadsvärde EUR"],["roi.forsaljningspris","Förväntat försäljningspris EUR"]].forEach(([p,l])=>{
      const pval=num(state.roi[p.split(".")[1]]);
      h+=`<div style="background:#fff;border:1px solid ${BORDER};border-radius:8px;padding:12px 14px;">
        <label style="font-size:10px;text-transform:uppercase;letter-spacing:0.08em;color:#8090a0;display:block;margin-bottom:6px;">${l}</label>
        ${inp(p,"number","0","right","font-size:19px;font-weight:700;")}
        ${c.boyta>0&&pval>0?`<div style="font-size:12px;color:#a0aab0;margin-top:4px;">${fmt(pval/c.boyta)} / m²</div>`:""}</div>`;
    });
    h+=`</div>`;

    // ROI kalkyl med alla siffror
    let rr=trow("Total köpkostnad",fmt(c.kopTotal));
    rr+=trow("Total renovering inkl. buffert",fmt(c.renovTotal));
    rr+=trow("TOTAL INVESTERING",fmt(c.totalInv),true);
    rr+=`<tr><td colspan="2" style="height:1px;background:${BORDER};padding:0;"></td></tr>`;
    rr+=trow("Förväntat marknadsvärde",fmt(num(state.roi.marknadsvarde)));
    rr+=trow("Förväntat försäljningspris",fmt(c.forsP));
    rr+=trow("Break-even nivå",fmt(c.totalInv));
    rr+=`<tr><td colspan="2" style="height:1px;background:${BORDER};padding:0;"></td></tr>`;
    rr+=trow("Beräknad vinst / förlust",c.forsP>0?fmtF(c.vinst):"—",true,c.vinst>=0?"#2ecc71":"#e74c3c");
    rr+=`<tr style="background:${NAVY};border-bottom:1px solid #333;">
      <td style="padding:12px 18px;font-size:14px;color:#8899bb;">ROI %</td>
      <td style="padding:12px 18px;text-align:right;font-size:24px;font-weight:700;color:${c.roiPct>=0?"#2ecc71":"#e74c3c"};">${c.forsP>0?pct(c.roiPct):"—"}</td></tr>`;
    rr+=`<tr style="border-bottom:1px solid #eee;">
      <td style="padding:9px 18px;font-size:14px;color:#5a6070;">Direktavkastning (Yield) uthyrning</td>
      <td style="padding:9px 18px;text-align:right;font-size:15px;font-weight:600;color:${NAVY};">${c.totalInv>0?pct(c.yieldPct):"—"}</td></tr>`;
    h+=tpanel("💰 ROI &amp; Investeringskalkyl",rr);

    // Risk
    h+=secHdr("⚠️","Riskchecklista");
    h+=`<div style="display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-bottom:8px;">`;
    RISKS.forEach(r=>{
      const chk=!!state.roi.riskar[r];
      h+=`<div onclick="toggleRisk('${r}')" style="display:flex;align-items:center;gap:6px;background:${chk?"#fce4e4":"#fff"};border:1px solid ${chk?"#c0392b":BORDER};border-radius:6px;padding:8px 10px;cursor:pointer;font-size:12px;color:${chk?"#c0392b":"#333"};">
        <div style="width:15px;height:15px;border:2px solid ${chk?"#c0392b":"#ccc"};border-radius:3px;background:${chk?"#c0392b":"transparent"};display:flex;align-items:center;justify-content:center;font-size:9px;color:#fff;flex-shrink:0;">${chk?"✓":""}</div>${r}</div>`;
    });
    h+=`</div>`;

    // Beslut
    h+=secHdr("✅","Slutligt beslut");
    h+=`<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:10px 0 20px;">`;
    [["kop","✅ KÖP","#27ae60","#e8f5e9"],["forh","🤝 FÖRHANDLA","#f39c12","#fef3e2"],["avst","❌ AVSTÅ","#c0392b","#fce4e4"]].forEach(([k,l,col,bg])=>{
      const ac=state.roi.beslut===k;
      h+=`<button onclick="setBeslut('${k}')" style="padding:14px;border:2px solid ${ac?col:BORDER};border-radius:7px;background:${ac?bg:"#fff"};color:${ac?col:"#7a7060"};font-size:14px;font-weight:600;cursor:pointer;">${l}</button>`;
    });
    h+=`</div>`;

    h+=secHdr("📝","Kommentarer &amp; slutsats");
    h+=ta("roi.kommentarer",5,"Sammanfattning, motivering, förhandlingsvillkor, nästa steg...");
  }

  h+=`</div>`;
  document.getElementById("root").innerHTML=h;
}
render();
</script>
</body>
</html>
